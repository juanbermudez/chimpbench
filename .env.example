# Optional local paths. Defaults use ~/Desktop/GHN and its pinned Decide environment.
# Restart pnpm dev after changing these server-only settings.
# MGOGO_GHN_ROOT=/Users/juanbermudez/Desktop/GHN
# MGOGO_DECIDE_PYTHON=/Users/juanbermudez/Desktop/GHN/data/raw/decide-env/bin/python
MGOGO_DECIDE_DEVICE=mps

# Public build-time override: browser | server | jev. Default: browser in both dev and production.
# VITE_DECISION_PROVIDER=browser

# Optional Jev gateway (server only). Disabled by default; never use VITE_ for API keys.
# TYPESAFE_API_KEY=your_key
# MGOGO_JEV_ENABLED=1
# MGOGO_JEV_MODEL=jev-latest
# MGOGO_JEV_MAX_CALLS=100
